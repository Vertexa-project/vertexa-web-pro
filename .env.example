# Variáveis do client VERTEXA Web Pro — APENAS chave anon (nunca a chave de serviço).
# Copie para .env e preencha com os valores do projeto Supabase compartilhado.
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua_anon_key_aqui

# Profissional atuante em modo demo (sem auth real): id do profile que envia
# mensagens e recebe menções no chat. No seed = Dra. Camila Rocha (...a2).
# Sob auth real isto vem de auth.uid() (ver docs/PENDENCIAS.md #14).
VITE_DEMO_PROFESSIONAL_PROFILE_ID=00000000-0000-0000-0000-0000000000a2
