# AUTH-EMAIL-02 — apontar o Professional WEB ao stack Supabase LOCAL.
# NÃO é produção. NÃO copie chaves do projeto remoto para este arquivo.
#
# Uso:
#   npm run env:local-auth
#   npm run dev:local-auth
#
# O script gera .env.authemail02.local (gitignored) a partir de `supabase status`
# do diretório isolado .tmp-authemail01. Este example só documenta o contrato.

VITE_SUPABASE_URL=http://127.0.0.1:55621
VITE_SUPABASE_ANON_KEY=local-anon-from-supabase-status
